{
    "name": "@arkitektum/altinn-studio-custom-components",
    "version": "17.9.2",
    "description": "Custom components for Altinn Studio",
    "license": "MIT",
    "main": "dist/main.js",
    "module": "dist/main.js",
    "exports": {
        ".": "./dist/main.js",
        "./styles.css": "./dist/main.css",
        "./resources.json": "./dist/resources.json",
        "./resources/nb.json": "./dist/resource.nb.json",
        "./dataModelBindingKeys.json": "./dist/dataModelBindingKeys.json",
        "./layout.schema.json": "./dist/layout.schema.json",
        "./package.json": "./package.json",
        "./dist/*": "./dist/*"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "symlinks": "node scripts/create-symlinks.js",
        "copy-dist-resources": "copyfiles --flat src/data/resource.*.json src/data/resources.json dist",
        "generate-data-model-binding-keys": "node scripts/generate-data-model-binding-keys.mjs",
        "update-altinn-layout-schema": "node scripts/update-altinn-layout-schema.mjs",
        "generate-layout-schema": "node scripts/generate-layout-schema.mjs",
        "test": "jest",
        "build": "yarn symlinks && NODE_ENV=production webpack && yarn copy-dist-resources && yarn generate-data-model-binding-keys && yarn generate-layout-schema",
        "start": "yarn symlinks && webpack serve --config webpack.config.dev.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Arkitektum/altinn-studio-custom-components.git"
    },
    "author": "",
    "bugs": {
        "url": "https://github.com/Arkitektum/altinn-studio-custom-components/issues"
    },
    "homepage": "https://github.com/Arkitektum/altinn-studio-custom-components#readme",
    "devDependencies": {
        "@babel/core": "^8.0.7",
        "@babel/preset-env": "^8.0.7",
        "@babel/preset-typescript": "^8.0.7",
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^30.5.2",
        "@microsoft/eslint-formatter-sarif": "^3.1.0",
        "ajv": "^8.20.0",
        "babel-loader": "^10.1.1",
        "copyfiles": "^2.4.1",
        "css-loader": "^7.1.5",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "dotenv": "^18.0.8",
        "dotenv-webpack": "^9.0.0",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "html-webpack-plugin": "^5.6.8",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "mini-css-extract-plugin": "^2.10.2",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vscode-json-languageservice": "^5.7.2",
        "vscode-languageserver-textdocument": "^1.0.15",
        "webpack": "^5.112.0",
        "webpack-cli": "^7.2.3",
        "webpack-dev-server": "^6.0.0"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "yarn@4.15.0",
    "dependencies": {
        "@arkitektum/altinn-studio-custom-components-utils": "^2.0.5",
        "@arkitektum/client-logger": "^1.2.2"
    }
}
