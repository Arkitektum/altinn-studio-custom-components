{
    "name": "@arkitektum/altinn-studio-custom-components",
    "version": "16.8.0",
    "description": "Custom components for Altinn Studio",
    "main": "dist/main.js",
    "module": "dist/main.js",
    "exports": {
        ".": "./dist/main.js",
        "./styles.css": "./dist/main.css",
        "./resources.json": "./dist/resources.json",
        "./resources/nb.json": "./dist/resource.nb.json",
        "./package.json": "./package.json",
        "./dist/*": "./dist/*"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "symlinks": "node scripts/create-symlinks.js",
        "copy-dist-resources": "copyfiles --flat src/data/resource.*.json src/data/resources.json dist",
        "test": "jest",
        "build": "yarn symlinks && NODE_ENV=production webpack && yarn copy-dist-resources",
        "start": "yarn symlinks && webpack serve --config webpack.config.dev.js",
        "lint": "eslint ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Arkitektum/altinn-studio-custom-components.git"
    },
    "author": "",
    "bugs": {
        "url": "https://github.com/Arkitektum/altinn-studio-custom-components/issues"
    },
    "homepage": "https://github.com/Arkitektum/altinn-studio-custom-components#readme",
    "devDependencies": {
        "@babel/preset-env": "^8.0.6",
        "@eslint/js": "^10.0.1",
        "copyfiles": "^2.4.1",
        "css-loader": "^7.1.5",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "date-fns": "^4.4.0",
        "date-fns-tz": "^3.2.0",
        "dotenv": "^18.0.0",
        "dotenv-webpack": "^9.0.0",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "html-webpack-plugin": "^5.6.8",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "mini-css-extract-plugin": "^2.10.2",
        "prettier": "3.9.8",
        "style-loader": "^4.0.0",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3",
        "webpack-dev-server": "^6.0.0"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "yarn@4.15.0",
    "dependencies": {
        "@arkitektum/altinn-studio-custom-components-utils": "^1.5.8",
        "@arkitektum/client-logger": "^1.2.2"
    }
}
