{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["esnext", "dom", "dom.iterable"],
        "strict": true,
        // A lookup into a record can miss, and this code falls back when it does. Without this, indexing hands back
        // a plain value and those fallbacks read as dead code.
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        // Relative imports name the .ts file they mean, the same convention as the utils package and the docs
        // gallery. Webpack and jest both resolve that literally, so a renamed file needs no loader configuration.
        "allowImportingTsExtensions": true,
        // This repository converts a directory at a time, so TypeScript and JavaScript sit side by side until it is
        // done. Checking the JavaScript too would turn the whole repository red on day one; eslint covers it.
        "allowJs": true,
        "checkJs": false,
        "resolveJsonModule": true,
        // Webpack builds the package through babel, which strips the types. Nothing is emitted from here.
        "noEmit": true
    },
    "include": ["src", "public"]
}
